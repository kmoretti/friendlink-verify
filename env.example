# Database provider: mongodb (default), sqlite, or mysql
DATABASE_PROVIDER=mongodb

# MongoDB connection string (required when DATABASE_PROVIDER=mongodb)
MONGODB_URI=mongodb+srv://user:password@cluster.xxxxx.mongodb.net/friendlink

# SQLite database file (required only when DATABASE_PROVIDER=sqlite)
# Docker Compose uses /data/friendlink.db by default.
SQLITE_PATH=/data/friendlink.db

# MySQL connection string (required when DATABASE_PROVIDER=mysql)
# MYSQL_URL=mysql://user:password@mysql:3306/friendlink
# Compose-only MySQL initialization variables (set them in your private .env)
# MYSQL_ROOT_PASSWORD=
# MYSQL_DATABASE=friendlink
# MYSQL_USER=friendlink
# MYSQL_PASSWORD=

# Compose-only MongoDB initialization variables (set them in your private .env)
# MONGO_INITDB_ROOT_USERNAME=
# MONGO_INITDB_ROOT_PASSWORD=
# MONGO_DATABASE=friendlink

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-secure-password

# JWT secret for session tokens
JWT_SECRET=generate-a-random-secret-string-here

# GitHub configuration (optional - only needed to auto-push to repo)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=owner/repo-name
# 仓库相对路径，不要以 / 开头
GITHUB_FILE_PATH=link.yml

# App URL for embed codes
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email SMTP configuration (optional - sends notification on new submissions)
EMAIL_USER=your-email@163.com
EMAIL_PASS=your-smtp-authorization-code
EMAIL_NAME=Your Site Name  # optional sender display name, defaults to EMAIL_USER
EMAIL_RECIPIENT=your-email@163.com
SMTP_SERVER=smtp.163.com
SMTP_PORT=465

# Docker Compose image (optional; omit to build friendlink-verify:local)
# IMAGE_NAME=ghcr.io/owner/repo:latest

# Dark mode schedule (optional - auto switch dark mode at specific times)
# NEXT_PUBLIC_DARK_MODE_START=18:00
# NEXT_PUBLIC_DARK_MODE_END=06:00
