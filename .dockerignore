# Secrets and environment-specific configuration must never enter the build context.
.env*

# Source-control and local dependency/build output.
.git
.gitignore
node_modules
.next

# Logs, reports, coverage, and temporary files.
*.log
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage
.nyc_output
*.tsbuildinfo
*.tmp
*.temp
tmp
temp
.cache
.vscode
.idea
.DS_Store
Thumbs.db

# Local database files, key material, and editor/OS artifacts.
*.pem
*.key
*.p12
*.pfx
secrets
.secrets
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
NUL
